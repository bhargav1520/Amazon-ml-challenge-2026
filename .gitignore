# ==============================================================================
# Amazon ML Challenge 2026 - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Challenge Datasets & Raw Data (Do not push GB-sized dataset TSVs to GitHub)
# ------------------------------------------------------------------------------
dataset/
datasets/
data/
raw_data/
processed_data/
student_resource/dataset/
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.jsonl

# ------------------------------------------------------------------------------
# 2. Model Weights, Checkpoints, Indexes & Embeddings
# ------------------------------------------------------------------------------
models/
model_checkpoints/
checkpoints/
weights/
embeddings/
indexes/
catboost_info/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.index
*.faiss

# ------------------------------------------------------------------------------
# 3. Output, Submissions, Predictions & Zip Archives
# ------------------------------------------------------------------------------
# Ignore generic output dumps and zip archives, but allow submission TSVs
submissions/
prediction/
predictions/
*.zip
*.tar
*.tar.gz
*.tgz

# Allow submission output files to be tracked in Git for team sharing
!output/
!output/matching_results.tsv
!output/candidate_pairs.tsv

# ------------------------------------------------------------------------------
# 4. Experiment Tracking, Logs & Cache Directories
# ------------------------------------------------------------------------------
runs/
experiments/
logs/
*.log
wandb/
mlruns/
lightning_logs/
.cache/
cache/
features/
dump.txt
temp/
tmp/

# ------------------------------------------------------------------------------
# 5. Python Environment, Bytecode & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 6. Testing, Type Checking & Code Quality
# ------------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# 7. Jupyter Notebooks & Interactive Development
# ------------------------------------------------------------------------------
.ipynb_checkpoints
profile_default/
ipython_config.py
tempCodeRunnerFile.py

# ------------------------------------------------------------------------------
# 8. IDE & Operating System Artifacts
# ------------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/

# OS-specific files
__MACOSX/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
